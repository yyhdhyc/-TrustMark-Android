<resources>
    <style name="Theme.TrustMarkTool" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.TrustMarkTool.Starting" parent="Theme.TrustMarkTool">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
